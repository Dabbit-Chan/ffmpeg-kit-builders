+// Global state reset (simplified for now, mimicking other libs)
+void ffplay_reset_internal_state(void) {
+    // Reset statics if possible or necessary.
+    // For ffplay, much state is in VideoState, but options are static.
+    // We can reset options via uninit_opts() which is called in do_exit.
+    // However, static ints like startup_volume, etc. persist.
+    // We should reset them:
+    input_filename = NULL;
+    window_title = NULL;
+    default_width  = 640;
+    default_height = 480;
+    screen_width  = 0;
+    screen_height = 0;
+    audio_disable = 0;
+    video_disable = 0;
+    subtitle_disable = 0;
+    seek_by_bytes = -1;
+    seek_interval = 10;
+    display_disable = 0;
+    borderless = 0;
+    alwaysontop = 0;
+    startup_volume = 100;
+    show_status = -1;
+    av_sync_type = AV_SYNC_AUDIO_MASTER;
+    start_time = AV_NOPTS_VALUE;
+    duration = AV_NOPTS_VALUE;
+    fast = 0;
+    genpts = 0;
+    lowres = 0;
+    decoder_reorder_pts = -1;
+    autoexit = 0;
+    exit_on_keydown = 0;
+    exit_on_mousedown = 0;
+    loop = 1;
+    framedrop = -1;
+    infinite_buffer = -1;
+    show_mode = SHOW_MODE_NONE;
+    audio_codec_name = NULL;
+    subtitle_codec_name = NULL;
+    video_codec_name = NULL;
+    rdftspeed = 0.02;
+    // cursor_last_shown // timestamp, doesn't matter much
+    cursor_hidden = 0;
+    // vfilters_list reset in do_exit
+    nb_vfilters = 0;
+    afilters = NULL;
+    autorotate = 1;
+    find_stream_info = 1;
+    filter_nbthreads = 0;
+    enable_vulkan = 0;
+    vulkan_params = NULL;
+    hwaccel = NULL;
+    
+    is_full_screen = 0;
+    
+    // window, renderer usually cleaned in do_exit/stream_close
+    window = NULL;
+    renderer = NULL;
+    vk_renderer = NULL;
 }
