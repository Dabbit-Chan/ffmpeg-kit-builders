+
+FFMPEG_THREAD_LOCAL OptionDef options[FF_ARRAY_ELEMS(options_template)];
+
+void ffmpeg_tls_init_options(void) {
+    memcpy(options, options_template, sizeof(options_template));
+
+    for (int i = 0; options[i].name != NULL; i++) {
+        if (strcmp(options[i].name, "hide_banner") == 0) options[i].u.dst_ptr = &hide_banner;
+        if (strcmp(options[i].name, "y") == 0) options[i].u.dst_ptr = &file_overwrite;
+        if (strcmp(options[i].name, "n") == 0) options[i].u.dst_ptr = &no_file_overwrite;
+        if (strcmp(options[i].name, "ignore_unknown") == 0) options[i].u.dst_ptr = &ignore_unknown_streams;
+        if (strcmp(options[i].name, "copy_unknown") == 0) options[i].u.dst_ptr = &copy_unknown_streams;
+        if (strcmp(options[i].name, "recast_media") == 0) options[i].u.dst_ptr = &recast_media;
+        if (strcmp(options[i].name, "benchmark") == 0) options[i].u.dst_ptr = &do_benchmark;
+        if (strcmp(options[i].name, "benchmark_all") == 0) options[i].u.dst_ptr = &do_benchmark_all;
+        if (strcmp(options[i].name, "stdin") == 0) options[i].u.dst_ptr = &stdin_interaction;
+        if (strcmp(options[i].name, "dump") == 0) options[i].u.dst_ptr = &do_pkt_dump;
+        if (strcmp(options[i].name, "hex") == 0) options[i].u.dst_ptr = &do_hex_dump;
+        if (strcmp(options[i].name, "frame_drop_threshold") == 0) options[i].u.dst_ptr = &frame_drop_threshold;
+        if (strcmp(options[i].name, "copyts") == 0) options[i].u.dst_ptr = &copy_ts;
+        if (strcmp(options[i].name, "start_at_zero") == 0) options[i].u.dst_ptr = &start_at_zero;
+        if (strcmp(options[i].name, "copytb") == 0) options[i].u.dst_ptr = &copy_tb;
+        if (strcmp(options[i].name, "dts_delta_threshold") == 0) options[i].u.dst_ptr = &dts_delta_threshold;
+        if (strcmp(options[i].name, "dts_error_threshold") == 0) options[i].u.dst_ptr = &dts_error_threshold;
+        if (strcmp(options[i].name, "xerror") == 0) options[i].u.dst_ptr = &exit_on_error;
+        if (strcmp(options[i].name, "filter_buffered_frames") == 0) options[i].u.dst_ptr = &filter_buffered_frames;
+        if (strcmp(options[i].name, "filter_complex_threads") == 0) options[i].u.dst_ptr = &filter_complex_nbthreads;
+        if (strcmp(options[i].name, "print_graphs") == 0) options[i].u.dst_ptr = &print_graphs;
+        if (strcmp(options[i].name, "print_graphs_file") == 0) options[i].u.dst_ptr = &print_graphs_file;
+        if (strcmp(options[i].name, "print_graphs_format") == 0) options[i].u.dst_ptr = &print_graphs_format;
+        if (strcmp(options[i].name, "auto_conversion_filters") == 0) options[i].u.dst_ptr = &auto_conversion_filters;
+        if (strcmp(options[i].name, "stats") == 0) options[i].u.dst_ptr = &print_stats;
+        if (strcmp(options[i].name, "debug_ts") == 0) options[i].u.dst_ptr = &debug_ts;
+        if (strcmp(options[i].name, "max_error_rate") == 0) options[i].u.dst_ptr = &max_error_rate;
+        if (strcmp(options[i].name, "vstats_version") == 0) options[i].u.dst_ptr = &vstats_version;
+    }
