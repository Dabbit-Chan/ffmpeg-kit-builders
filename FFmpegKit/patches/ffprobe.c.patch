+static int write_buffer_packet(void *opaque, const uint8_t *buf, int buf_size)  {
+    AVBPrint *bp = (AVBPrint *)opaque;
+    av_bprint_append_data(bp, (const char *)buf, buf_size);
+    return buf_size;
+}
+
+void ffprobe_reset_internal_state(void)
+{
+    // Reset counters and flags
+    nb_streams = 0;
+    av_freep(&nb_streams_packets);
+    av_freep(&nb_streams_frames);
+    av_freep(&selected_streams);
+    av_freep(&streams_with_closed_captions);
+    av_freep(&streams_with_film_grain);
+    
+    // Clear log buffer
+    ff_mutex_lock(&log_mutex);
+    for (int i=0; i<log_buffer_size; i++) {
+        av_freep(&log_buffer[i].context_name);
+        av_freep(&log_buffer[i].parent_name);
+        av_freep(&log_buffer[i].log_message);
+    }
+    av_freep(&log_buffer);
+    log_buffer_size = 0;
+    ff_mutex_unlock(&log_mutex);
+
+    // Reset options constants if they were modified
+    do_analyze_frames = 0;
+    do_show_frames = 0;
+    do_show_packets = 0;
+}
