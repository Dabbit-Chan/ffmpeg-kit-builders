diff --git a/src/ffmpeg_sched.c b/src/ffmpeg_sched.c
index 3180367..af5a1e2 100755
--- a/src/ffmpeg_sched.c
+++ b/src/ffmpeg_sched.c
@@ -2565,10 +2565,21 @@ static int task_stop(Scheduler *sch, SchTask *task)
         return task_cleanup(sch, task->node);
 
     ret = pthread_join(task->thread, &thread_ret);
-    av_assert0(ret == 0);
 
-    task->thread_running = 0;
+#ifdef _WIN32
+    if (ret == ESRCH) {
+        av_log(NULL, AV_LOG_WARNING,
+               "[ffmpeg-kit] task_stop: pthread_join ESRCH for node "
+               "type=%d idx=%d — thread completed normally, "
+               "skipping task_cleanup.\n",
+               task->node.type, task->node.idx);
+        task->thread_running = 0;
+        return 0;
+    }
+#endif
 
+    av_assert0(ret == 0);
+    task->thread_running = 0;
     return (intptr_t)thread_ret;
 }
 
