--- a/src/ffmpeg_sched.c
+++ b/src/ffmpeg_sched.c
@@ -2524,6 +2524,8 @@ static int task_cleanup(Scheduler *sch, SchedulerNode node)
     }
 }
 
+extern void ffmpeg_tls_init_options(void);
